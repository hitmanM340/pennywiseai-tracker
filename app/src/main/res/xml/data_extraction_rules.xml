<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude hardware-backed Keystore preferences from cloud backup -->
        <exclude domain="sharedpref" path="pennywise_secure_prefs.xml" />
        <exclude domain="sharedpref" path="database_key_prefs.xml" />
        <exclude domain="sharedpref" path="device_encryption_prefs.xml" />
        <exclude domain="database" path="pennywise_database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pennywise_secure_prefs.xml" />
        <exclude domain="sharedpref" path="database_key_prefs.xml" />
        <exclude domain="sharedpref" path="device_encryption_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
